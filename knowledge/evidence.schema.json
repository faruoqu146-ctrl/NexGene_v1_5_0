{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexGeneEvidenceRecord",
  "type": "object",
  "required": ["id", "source", "title", "retrieved_at"],
  "properties": {
    "id": {"type": "string"},
    "source": {"type": "string", "enum": ["pubmed", "crossref", "manual", "learning"]},
    "title": {"type": "string"},
    "abstract": {"type": "string"},
    "doi": {"type": "string"},
    "pmid": {"type": "string"},
    "url": {"type": "string"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "provenance": {"type": "object"}
  }
}
